{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    { "source": "/download/mac", "destination": "https://github.com/hmzakhalid/hop/releases/latest/download/Hop.dmg", "permanent": false },
    { "source": "/download/windows", "destination": "https://github.com/hmzakhalid/hop/releases/latest/download/Hop-Setup.exe", "permanent": false },
    { "source": "/github", "destination": "https://github.com/hmzakhalid/hop", "permanent": false },
    { "source": "/guide", "destination": "https://github.com/hmzakhalid/hop/blob/main/docs/USER_GUIDE.md", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" }
      ]
    },
    {
      "source": "/(.*)\\.(png|svg)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
